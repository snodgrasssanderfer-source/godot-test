{
  "mcpServers": {
    "godot": {
      "command": "node",
      "args": [
        "/opt/godot-mcp/build/index.js"
      ],
      "env": {
        "GODOT_PATH": "/home/user/godot-test/tools/godot-headless.sh",
        "DEBUG": "false"
      }
    },
    "blender": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/sandraschi/blender-mcp@b786a397747970a17b74983c9aab657b8a014789",
        "blender-mcp",
        "--stdio"
      ],
      "env": {
        "BLENDER_EXECUTABLE": "/opt/blender/blender"
      }
    }
  }
}
